# Serves the browser (wasm) build of nxvim as static files.
#
# The browser client is arch-independent wasm, deployed as a static bundle (the same
# way it ships to a CDN) — so this image does NOT compile anything; it serves a bundle
# you build once on the host. Build that bundle first:
#
#     crates/nxvim-edithost/build.sh        # produces dist/ + web/vendor/ (needs emcc + node)
#
# Then build + run this image. The build context is the edit-host crate dir, so build
# from the REPO ROOT with an explicit context:
#
#     podman build -f examples/docker-daemon/Containerfile.web -t nxvim-web crates/nxvim-edithost
#     podman run --rm -p 127.0.0.1:8088:8088 --name nxvim-web nxvim-web
#
# The page is then at http://localhost:8088/web/ . It is a *static* host: the actual
# WebTransport connection to the daemon is made by YOUR browser (on the host), not by
# this container — so the daemon URI handed to the page must point at the daemon's
# host-published address (127.0.0.1:8765), which is what connect-web.sh fills in.

FROM docker.io/library/node:22-bookworm-slim

WORKDIR /app

# serve.mjs serves its parent dir (/app) and expects the app under /web/ with dist/
# alongside (../dist/eh.{mjs,wasm} relative to the page). node_modules is excluded by
# the crate's .dockerignore — the server has no runtime npm deps.
COPY dist ./dist
COPY web ./web

# Cross-origin isolation headers (COOP/COEP/CORP) come from serve.mjs — required for the
# SharedArrayBuffer the worker uses. localhost is a secure context, so WebTransport works.
EXPOSE 8088
CMD ["node", "web/serve.mjs", "8088"]

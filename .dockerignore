# Keep the container build context small. The Containerfile (see
# examples/docker-daemon) compiles from source inside the image, so none of the
# local build output, VCS, or web/node artifacts need to be sent.
target/
**/target/
.git/
**/node_modules/
crates/bemtvi-web/pkg/
crates/bemtvi-web/dist/
**/*.wasm
vendor/neovim/
.basedpyright-src

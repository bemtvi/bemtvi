# Throwaway build outputs (the Cargo.lock IS committed for this excluded wasm crate).
/target
/dist

# The assembled static publish roots for Netlify: _site = the standard editor
# (netlify-build.sh), _site-demo = the python demo (netlify-build-demo.sh). Both stage
# web/ + dist/ + _headers from the build outputs above. Generated per deploy, never committed.
/_site
/_site-demo

# The assembled python-demo static site for local dev/verify (build-demo.sh → package-site.sh
# --demo: web/ + dist/ + Pyodide, build-config.js localHost:true). Generated, never committed.
/demo-site

# Playwright/npm install artifacts for the browser verifier (web/package.json is
# tracked; these are regenerated by `npm install`, never committed).
/web/node_modules
/web/package-lock.json

# Tree-sitter highlighter tooling: npm install artifacts + the generated assets
# (~13 MB of runtime + grammar .wasm + queries), produced by treesitter/ and copied
# into web/vendor/ by build.sh. Regenerated, not committed (treesitter/package.json +
# package-lock.json + scripts/ ARE tracked).
/treesitter/node_modules
/treesitter/vendor
/web/vendor

# basedpyright build clone (build-basedpyright.sh) — regenerated, not committed
/.basedpyright-src

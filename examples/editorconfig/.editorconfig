; EditorConfig (https://editorconfig.org) — nxvim reads this automatically.
; `root = true` stops the upward search here (no parent .editorconfig leaks in).
root = true

; Defaults for every file under this directory.
[*]
indent_style = space
indent_size = 4
end_of_line = lf
charset = utf-8

; Lua indents with two spaces (overrides the [*] indent_size above).
[*.lua]
indent_size = 2

; Makefiles must use real tabs, 8 cells wide. The brace group matches either name.
[{Makefile,*.mk}]
indent_style = tab
tab_width = 8

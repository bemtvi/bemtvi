# Throwaway build outputs (the Cargo.lock IS committed for this excluded wasm crate).
/target
/dist

# The assembled static publish root for Netlify (netlify-build.sh stages web/ + dist/
# + _headers here from the build outputs above). Generated per deploy, never committed.
/_site

# Playwright/npm install artifacts for the browser verifier (web/package.json is
# tracked; these are regenerated by `npm install`, never committed).
/web/node_modules
/web/package-lock.json

# Tree-sitter highlighter tooling: npm install artifacts + the generated assets
# (~13 MB of runtime + grammar .wasm + queries), produced by treesitter/ and copied
# into web/vendor/ by build.sh. Regenerated, not committed (treesitter/package.json +
# package-lock.json + scripts/ ARE tracked).
/treesitter/node_modules
/treesitter/vendor
/web/vendor

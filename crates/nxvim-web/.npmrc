# The tree-sitter grammar packages are pulled in purely for the prebuilt `.wasm`
# and `queries/*.scm` files inside their tarballs (see scripts/gen-treesitter.mjs).
# Their install scripts only run node-gyp to compile the *native* Node addon, which
# this WebAssembly-only build never loads and which fails without a full C toolchain.
# Skip every package's install scripts so `npm ci` just unpacks the tarballs.
ignore-scripts=true

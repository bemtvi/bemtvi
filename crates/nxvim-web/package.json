{
  "name": "nxvim-web-frontend",
  "private": true,
  "description": "Build tooling for the nxvim web demo: the Tailwind stylesheet, plus the tree-sitter runtime/grammars/queries vendored into web/vendor/. Only used at build time (build.sh); the demo itself ships static assets and loads no runtime CDN.",
  "scripts": {
    "build:css": "tailwindcss -i tailwind.input.css -o web/tailwind.css --minify",
    "build:treesitter": "node scripts/gen-treesitter.mjs"
  },
  "devDependencies": {
    "@tailwindcss/cli": "4.3.0",
    "tailwindcss": "4.3.0",
    "web-tree-sitter": "0.26.9",
    "tree-sitter-rust": "0.24.0",
    "tree-sitter-javascript": "0.25.0",
    "tree-sitter-typescript": "0.23.2",
    "tree-sitter-json": "0.24.8",
    "tree-sitter-python": "0.25.0",
    "tree-sitter-ruby": "0.23.1",
    "tree-sitter-php": "0.24.2",
    "tree-sitter-cpp": "0.23.4",
    "tree-sitter-c": "0.24.1",
    "tree-sitter-go": "0.25.0",
    "@tree-sitter-grammars/tree-sitter-zig": "1.1.2",
    "@tree-sitter-grammars/tree-sitter-lua": "0.4.1"
  }
}
